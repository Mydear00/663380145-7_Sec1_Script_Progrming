{
  "tasks": [
    {
      "name": "Send Daily Sales Report Email",
      "type": "send_email",
      "parameters": {
        "recipients": {
          "to": [
            "${TEST_RECIPIENT_EMAIL}"
          ],
          "cc": [
            "${SENDER_EMAIL}"
          ],
          "bcc": []
        },
        "subject_template": "Daily Sales Report - {report_date}",
        "body_template": "Dear Team,\n\nPlease find the latest sales report for {report_date}.\nTotal sales: ${sales_figure:.2f}. Total active customers: {total_customers}.\n\nBest regards,\nAutomated Agent",
        "attachments": [
          "data/reports/sales_report.pdf",
          "data/reports/summary_data.xlsx"
        ],
        "is_html": false
      },
      "output_context_key": "sales_email_result"
    },
    {
      "name": "Send Sales Alert SMS",
      "type": "send_sms",
      "enabled": false,
      "parameters": {
        "phone_numbers": [
          "${TEST_SMS_PHONE_NUMBER}"
        ],
        "message_template": "Sales for {report_date}: ${sales_figure:.2f}; customers: {total_customers}.",
        "carrier_name": "${TEST_SMS_CARRIER}"
      },
      "output_context_key": "sales_sms_result"
    },
    {
      "name": "Simulate Incoming Request Email (to self)",
      "type": "send_email",
      "enabled": false,
      "parameters": {
        "recipients": {
          "to": [
            "${SENDER_EMAIL}"
          ]
        },
        "subject_template": "Data Request for {report_date} - Urgent",
        "body_template": "Hello Agent,\n\nPlease process the new data processing request urgently. This is a simulated request for the lab.",
        "attachments": [
          "data/reports/sales_report.pdf"
        ],
        "is_html": false
      },
      "output_context_key": "simulated_email_sent"
    },
    {
      "name": "Process Incoming Data Requests",
      "type": "process_inbox",
      "parameters": {
        "mailbox": "INBOX",
        "search_criteria": {
          "status": "UNSEEN",
          "from_sender": "${SENDER_EMAIL}",
          "subject_contains": "Data Request"
        },
        "download_attachments_base_dir": "data/incoming_attachments",
        "allowed_extensions": [
          ".pdf",
          ".xlsx"
        ],
        "rules": [
          {
            "name": "Urgent request with attachments",
            "if": {
              "subject_contains": "Urgent",
              "has_attachments": true
            },
            "then": {
              "send_sms_alert": false,
              "alert_phone_numbers": [
                "${TEST_SMS_PHONE_NUMBER}"
              ],
              "alert_carrier": "${TEST_SMS_CARRIER}",
              "alert_message_template": "URGENT: Request from {sender} - {subject}. Check {attachments_meta.0.filepath}"
            }
          },
          {
            "name": "Reply to processing request",
            "if": {
              "body_contains": "new data processing"
            },
            "then": {
              "reply_with_template": "Agent received your request for '{subject}'. We are now processing the new data. You will receive an update shortly.",
              "reply_subject_template": "Re: {subject} - Received & Processing"
            }
          }
        ]
      },
      "output_context_key": "processed_inbox_results"
    }
  ]
}